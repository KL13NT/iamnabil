---
import Base from '@/layouts/Base.astro'
import { generateImageSizes, formatDate } from '@/utils'
import { Picture } from 'astro:assets'
import { getCaseStudies } from '@/api'

const posts = await getCaseStudies()
---

<Base title='Work' description="Projects I'm proud to have worked on.">
	<div>
		<h1>Independent Work</h1>
		<p>Projects I'm proud to have worked on.</p>
	</div>
	<div class='mt-12'>
		<ul
			class:list={{
				'p-0 mx-auto w-full max-w-7xl grid gap-8 grid-cols-1': true
			}}
			data-animation-parent
			data-lang='en'
		>
			{
				posts.map(({ data: { title, description, cover, date }, id }) => {
					return (
						<li class='list-none mt-0 w-full' dir='ltr'>
							<a
								href={`/${id}`}
								class='group bg-transparent block w-full h-full sm:max-w-full no-underline'
							>
								{cover && (
									<Picture
										src={cover?.thumb ?? cover.path}
										class='motion-safe:transition-all rounded-md outline-0 outline-red-500 outline-offset-0 group-hover:outline-2 group-hover:outline-offset-4 w-full h-[580px] lg:h-[580px] object-cover m-0 overflow-hidden'
										alt=''
										loading='lazy'
										formats={['avif']}
										fallbackFormat='avif'
										{...generateImageSizes({
											sm: 100,
											lg: 30,
											xxl: 20
										})}
										inferSize
									/>
								)}
								<span class='block text-lg mt-4'>{formatDate(date, 'en')}</span>

								<h2 class='mx-auto text-3xl inline mt-4 bg-gradient-to-r from-link to-link bg-[length:0px_10px] bg-left-bottom rtl:bg-right-bottom bg-no-repeat motion-safe:transition-[background-size] duration-500 group-hover:bg-[length:100%_10px]'>
									{title}
								</h2>
								<p class='mt-0'>{description}</p>
							</a>
						</li>
					)
				})
			}
		</ul>
	</div>
</Base>
